FROM ubuntu:22.04@sha256:104ae83764a5119017b8e8d6218fa0832b09df65aae7d5a6de29a85d813da2fb
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git build-essential clang lld cmake ninja-build \
    python3 python3-numpy python3-pip libgmp-dev libboost-dev \
    libzstd-dev zlib1g-dev libtinfo-dev
WORKDIR /work
